# Server execution environment: development | production | test
NODE_ENV=development

# Port number for the Express server to listen on
PORT=5000

# MongoDB Atlas connection URI with database name mindlog
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/mindlog?retryWrites=true&w=majority

# Optional: Comma-separated custom DNS servers if your network blocks SRV lookups (e.g. 8.8.8.8,1.1.1.1)
# DNS_SERVERS=8.8.8.8,1.1.1.1

# Comma-separated list of allowed client origins for CORS
CLIENT_ORIGINS=http://localhost:5173

# --- Required for Authentication (Phase 3) ---
# Secret key used to sign and verify JWT authentication tokens (minimum 32 characters)
JWT_SECRET=your_minimum_32_characters_long_jwt_secret_here
# Lifetime of both the JWT token and the HttpOnly cookie in days
JWT_EXPIRES_DAYS=7
# Name of the HttpOnly authentication cookie
COOKIE_NAME=mindlog_token
# Cookie SameSite attribute: lax (recommended for same-origin proxy) | strict | none (for cross-origin)
COOKIE_SAMESITE=lax
# Number of bcrypt hashing rounds for passwords (minimum 4, default 12)
BCRYPT_SALT_ROUNDS=12

# --- Required from Phase 5 (Media Uploads) ---
# Cloudinary cloud name for media assets
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
# Cloudinary API key
CLOUDINARY_API_KEY=your_cloudinary_api_key
# Cloudinary API secret
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
# Optional: Temporary directory for multipart uploads (defaults to OS temp directory / mindlog-uploads)
# MEDIA_TMP_DIR=/tmp/mindlog-uploads
